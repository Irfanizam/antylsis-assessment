# --- Database ---
# matches docker-compose (host port 5544). Change if you run Postgres elsewhere.
DATABASE_URL=postgresql://receipthub:receipthub@localhost:5544/receipthub

# --- Server ---
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# --- Auth ---
# MUST be at least 32 chars. Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1h
BCRYPT_COST=12

# --- File upload ---
STORAGE_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

# --- Voucher policy (business rule is config, not a literal in code) ---
VOUCHER_VALUE=5.00
VOUCHER_VALIDITY_DAYS=90

# --- Seed (dev demo accounts) ---
SEED_ADMIN_EMAIL=admin@receipthub.test
SEED_ADMIN_PASSWORD=Admin123!
SEED_USER_PASSWORD=User123!
