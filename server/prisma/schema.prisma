generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ReceiptStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VoucherStatus {
  ACTIVE
  REDEEMED
  EXPIRED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String?  @unique
  phone        String?  @unique
  passwordHash String   @map("password_hash")
  fullName     String?  @map("full_name")
  role         UserRole @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  receipts        Receipt[] @relation("ReceiptOwner")
  reviewedReceipts Receipt[] @relation("ReceiptReviewer")
  vouchers        Voucher[]

  @@map("users")
}

model Receipt {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  user             User          @relation("ReceiptOwner", fields: [userId], references: [id], onDelete: Restrict)
  orderId          String        @map("order_id")
  purchaseDate     DateTime      @map("purchase_date") @db.Date
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("MYR") @db.Char(3)
  status           ReceiptStatus @default(PENDING)

  fileKey          String        @map("file_key")
  fileOriginalName String        @map("file_original_name")
  fileMimeType     String        @map("file_mime_type")
  fileSizeBytes    Int           @map("file_size_bytes")

  reviewedById     String?       @map("reviewed_by") @db.Uuid
  reviewedBy       User?         @relation("ReceiptReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?     @map("reviewed_at")
  reviewNote       String?       @map("review_note")

  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  voucher          Voucher?

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("receipts")
}

model Voucher {
  id         String        @id @default(uuid()) @db.Uuid
  code       String        @unique
  receiptId  String        @unique @map("receipt_id") @db.Uuid
  receipt    Receipt       @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  userId     String        @map("user_id") @db.Uuid
  user       User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  amount     Decimal       @db.Decimal(12, 2)
  currency   String        @default("MYR") @db.Char(3)
  status     VoucherStatus @default(ACTIVE)
  issuedAt   DateTime      @default(now()) @map("issued_at")
  expiresAt  DateTime?     @map("expires_at")
  redeemedAt DateTime?     @map("redeemed_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@index([userId, status])
  @@map("vouchers")
}
